{
    "name": "multek/laravel-customer-engagement",
    "description": "A unified customer engagement platform for Laravel — contracts, DTOs, and manager for push notifications, user sync, and event tracking across multiple providers.",
    "keywords": ["laravel", "customer-engagement", "notifications", "push", "onesignal", "braze", "firebase"],
    "license": "MIT",
    "authors": [
        {
            "name": "Multek"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Multek\\CustomerEngagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Multek\\CustomerEngagement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Multek\\CustomerEngagement\\CustomerEngagementServiceProvider"
            ],
            "aliases": {
                "Engagement": "Multek\\CustomerEngagement\\Facades\\Engagement"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
